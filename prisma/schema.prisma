generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                String           @id @default(uuid())
  authUserId        String           @unique
  userType          UserType
  email             String           @unique
  firstName         String
  lastName          String
  nationalId        String?          @unique
  gender            Gender?
  birthDate         DateTime?
  preferredLanguage String           @default("fr")
  phone             String?
  avatarUrl         String?
  address           String?
  city              String?
  wilaya            String?
  postalCode        String?
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  isVerified        Boolean          @default(false)
  accountStatus     AccountStatus    @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  admin             Admin?
  doctor            Doctor?
  laboratoryStaff   LaboratoryStaff?
  patient           Patient?
  pharmacist        Pharmacist?

  @@index([userType])
  @@index([city])
  @@index([wilaya])
}

model HealthcareFacility {
  id                 String               @id @default(uuid())
  name               String
  type               FacilityType
  registrationNumber String?              @unique
  description        String?
  phone              String?
  email              String?
  website            String?
  address            String?
  city               String?
  wilaya             String?
  postalCode         String?
  latitude           Decimal?             @db.Decimal(10, 7)
  longitude          Decimal?             @db.Decimal(10, 7)
  openingHours       Json?
  emergencyService   Boolean              @default(false)
  isVerified         Boolean              @default(false)
  logoUrl            String?
  coverImageUrl      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  doctors            DoctorFacility[]
  laboratoryStaff    LaboratoryFacility[]
  pharmacists        PharmacistFacility[]
  stocks             PharmacyStock[]
  stockRequests      StockRequest[]
  reservations       PharmacyReservation[]
  labProducts        LabProduct[]

  @@index([type])
  @@index([city])
  @@index([wilaya])
}

model Specialty {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  doctors     DoctorSpecialty[]
}

model Doctor {
  id        String @id @default(uuid())
  profileId String @unique

  // Professional identification
  licenseNumber        String  @unique
  nationalRegistration String? @unique

  // Education
  diploma        String?
  diplomaNumber  String?
  graduationYear Int?

  // Experience
  startPracticeYear Int?
  yearsExperience   Int?

  // Professional information
  biography             String?
  consultationLanguages String?
  education             String?
  certifications        String?

  // Consultation
  consultationFee        Decimal? @db.Decimal(10, 2)
  consultationDuration   Int?
  acceptsOnline          Boolean  @default(false)
  acceptsHomeVisit       Boolean  @default(false)
  isAcceptingNewPatients Boolean  @default(true)

  // Rating
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalReviews  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  facilities     DoctorFacility[]
  specialties    DoctorSpecialty[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  directConversations DirectConversation[]
}

model DoctorSpecialty {
  doctorId    String
  specialtyId String
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
}

model DoctorFacility {
  doctorId   String
  facilityId String
  doctor     Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility   HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([doctorId, facilityId])
}

model Patient {
  id        String @id @default(uuid())
  profileId String @unique

  // ============================================================
  // MEDICAL INFORMATION PROVIDED BY THE PATIENT
  // ============================================================

  bloodType            String?
  allergies            String?
  chronicConditions    String?
  currentMedications   String?
  medicalHistory       String?
  surgicalHistory      String?
  familyMedicalHistory String?
  vaccinationHistory   String?

  // ============================================================
  // LIFESTYLE
  // ============================================================

  smokingStatus      String?
  alcoholConsumption String?
  physicalActivity   String?
  diet               String?

  // ============================================================
  // ADDITIONAL MEDICAL INFORMATION
  // ============================================================

  additionalMedicalInfo String?

  // ============================================================
  // EMERGENCY CONTACT
  // ============================================================

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // ============================================================
  // GUARDIAN - MAINLY FOR MINORS
  // ============================================================

  guardianFirstName String?
  guardianLastName  String?
  guardianEmail     String?
  guardianPhone     String?
  guardianRelation  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Jeton public d'urgence (QR Emergency Card) : révocable, régénérable.
  emergencyToken String? @unique

  conversations     AIConversation[]
  appointments      Appointment[]
  laboratoryResults LaboratoryResult[]
  medicalRecords    MedicalRecord[]
  profile           Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  prescriptions     Prescription[]
  refillRequests    RefillRequest[]
  vaccinations      Vaccination[]
  directConversations DirectConversation[]
  stockRequests     StockRequest[]
  stockAlerts       StockAlert[]
  reservations      PharmacyReservation[]
}

model DirectConversation {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
}

model DirectMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderRole     String
  senderId       String
  senderName     String
  text           String
  read           Boolean  @default(false)
  attachment     Json?
  createdAt      DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ============================================================
// DISCUSSIONS ENTRE MÉDECINS (1:1 et groupes) — persistées en base.
// groupName null => discussion directe entre 2 médecins.
// doctorId stockés en simples String (aucune modification des tables
// Doctor existantes, appartenance vérifiée côté API).
// ============================================================

model DoctorThread {
  id          String   @id @default(uuid())
  groupName   String?
  specialty   String?
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  DoctorThreadMember[]
  messages DoctorThreadMessage[]

  @@index([updatedAt])
}

model DoctorThreadMember {
  threadId String
  doctorId String
  joinedAt DateTime @default(now())

  thread DoctorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, doctorId])
  @@index([doctorId])
}

model DoctorThreadMessage {
  id         String   @id @default(uuid())
  threadId   String
  senderId   String
  senderName String
  text       String
  readBy     String[] @default([])
  createdAt  DateTime @default(now())

  thread DoctorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// ============================================================
// PHARMACIES : stock par pharmacie, réservations patients,
// alertes de disponibilité.
// ============================================================

model PharmacyStock {
  id             String   @id @default(uuid())
  facilityId     String
  medicationName String
  dosage         String?
  quantity       Int      @default(0)
  lowThreshold   Int      @default(5)
  price          Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facility HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, medicationName, dosage])
  @@index([facilityId])
  @@index([medicationName])
}

model StockRequest {
  id             String   @id @default(uuid())
  patientId      String
  facilityId     String
  medicationName String
  dosage         String?
  quantity       Int      @default(1)
  prescriptionId String?
  prescriptionFileUrl String?
  prescriptionFileName String?
  status         String   @default("PENDING")
  pickupCode     String?  @unique
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient  Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([facilityId])
  @@index([status])
}

model StockAlert {
  id             String   @id @default(uuid())
  patientId      String
  medicationName String
  wilaya         String?
  city           String?
  createdAt      DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([medicationName])
}

// ============================================================
// RÉSERVATIONS GROUPÉES : un panier = un code de retrait,
// revue médicament par médicament côté pharmacie.
// Header PENDING -> READY (>=1 CONFIRMED) / REFUSED (tout refusé)
// -> COMPLETED (achat terminé, stock décrémenté) / CANCELLED.
// Item PENDING -> CONFIRMED / REFUSED.
// Ordonnance optionnelle : prescriptionId (plateforme) et/ou
// fichier image/PDF (data URL stockée en texte).
// ============================================================

model PharmacyReservation {
  id                  String   @id @default(uuid())
  patientId           String
  facilityId          String
  pickupCode          String?  @unique
  status              String   @default("PENDING")
  prescriptionId      String?
  prescriptionFileUrl String?
  prescriptionFileName String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patient  Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  items    PharmacyReservationItem[]

  @@index([patientId])
  @@index([facilityId])
  @@index([status])
}

model PharmacyReservationItem {
  id             String   @id @default(uuid())
  reservationId  String
  medicationName String
  dosage         String?
  quantity       Int      @default(1)
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  reservation PharmacyReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

// ============================================================
// LABORATOIRES PHARMACEUTIQUES : catalogue produits, ciblage
// par spécialités (vide = toutes), notifications médecins,
// compteurs de portée (vues/clics) pour la facturation.
// ============================================================

model LabProduct {
  id           String   @id @default(uuid())
  facilityId   String
  name         String
  dci          String?
  dosage       String?
  forme        String?
  indications  String?
  price        Decimal? @db.Decimal(10, 2)
  description  String?
  docUrl       String?
  docName      String?
  specialtyIds String[] @default([])
  status       String   @default("DRAFT")
  views        Int      @default(0)
  clicks       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([status])
}

model DoctorNotification {
  id        String   @id @default(uuid())
  doctorId  String
  productId String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([doctorId])
  @@index([productId])
}

// ============================================================
// ABONNEMENTS FREEMIUM : FREE par défaut, PREMIUM payant.
// Un abonnement par profil. Test mode (sans banque) : activation
// immédiate, à brancher sur SATIM réel plus tard.
// ============================================================

model Subscription {
  id          String   @id @default(uuid())
  profileId   String   @unique
  userType    String
  plan        String   @default("FREE")
  status      String   @default("ACTIVE")
  cycle       String?
  provider    String?
  providerRef String?
  startedAt   DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model CallLog {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  doctorId      String
  patientId     String
  mode          String   @default("video")
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  durationSec   Int      @default(0)

  @@index([doctorId])
  @@index([patientId])
}

model Pharmacist {
  id            String               @id @default(uuid())
  profileId     String               @unique
  licenseNumber String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  profile       Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  facilities    PharmacistFacility[]
}

model PharmacistFacility {
  pharmacistId String
  facilityId   String
  facility     HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  pharmacist   Pharmacist         @relation(fields: [pharmacistId], references: [id], onDelete: Cascade)

  @@id([pharmacistId, facilityId])
}

model LaboratoryStaff {
  id            String               @id @default(uuid())
  profileId     String               @unique
  licenseNumber String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  facilities    LaboratoryFacility[]
  profile       Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LaboratoryFacility {
  laboratoryStaffId String
  facilityId        String
  facility          HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  laboratoryStaff   LaboratoryStaff    @relation(fields: [laboratoryStaffId], references: [id], onDelete: Cascade)

  @@id([laboratoryStaffId, facilityId])
}

model Admin {
  id        String   @id @default(uuid())
  profileId String   @unique
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  previousDate    DateTime?
  type            AppointmentType   @default(IN_PERSON)
  status          AppointmentStatus @default(PENDING)
  reason          String?
  notes           String?
  location        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
}

model MedicalRecord {
  id         String   @id @default(uuid())
  patientId  String
  doctorId   String?
  title      String
  diagnosis  String?
  symptoms   String?
  notes      String?
  recordDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  doctor     Doctor?  @relation(fields: [doctorId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id                 String             @id @default(uuid())
  patientId          String
  doctorId           String
  prescriptionNumber String             @unique
  prescribedDate     DateTime           @default(now())
  startDate          DateTime?
  endDate            DateTime?
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items              PrescriptionItem[]
  refillRequests     RefillRequest[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicationName String
  dosage         String
  frequency      String?
  route          String?
  durationDays   Int?
  quantity       Int?
  instructions   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model RefillRequest {
  id             String       @id @default(uuid())
  patientId      String
  prescriptionId String
  requestedDate  DateTime     @default(now())
  status         RefillStatus @default(REQUESTED)
  notes          String?
  response       String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([prescriptionId])
  @@index([status])
}

model LaboratoryResult {
  id             String                @id @default(uuid())
  patientId      String
  testName       String
  laboratoryName String?
  testDate       DateTime
  status         LaboratoryStatus      @default(PENDING)
  reportUrl      String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  parameters     LaboratoryParameter[]
  patient        Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([testDate])
  @@index([status])
}

model LaboratoryParameter {
  id                 String           @id @default(uuid())
  laboratoryResultId String
  name               String
  value              String
  unit               String?
  referenceMin       Decimal?         @db.Decimal(10, 3)
  referenceMax       Decimal?         @db.Decimal(10, 3)
  flag               ResultFlag       @default(NORMAL)
  createdAt          DateTime         @default(now())
  laboratoryResult   LaboratoryResult @relation(fields: [laboratoryResultId], references: [id], onDelete: Cascade)

  @@index([laboratoryResultId])
}

model Vaccination {
  id              String    @id @default(uuid())
  patientId       String
  vaccineName     String
  dose            String?
  vaccinationDate DateTime
  nextDueDate     DateTime?
  provider        String?
  batchNumber     String?
  notes           String?
  createdAt       DateTime  @default(now())
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([vaccinationDate])
}

model AIConversation {
  id        String             @id @default(uuid())
  patientId String
  title     String?
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([patientId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum UserType {
  PATIENT
  DOCTOR
  PHARMACIST
  LABORATORY_STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  ONLINE
  HOME_VISIT
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RefillStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum LaboratoryStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

enum FacilityType {
  HOSPITAL
  CLINIC
  PRIVATE_OFFICE
  PHARMACY
  LABORATORY
  HEALTH_CENTER
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}
