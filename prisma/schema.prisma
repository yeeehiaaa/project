generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                String           @id @default(uuid())
  authUserId        String           @unique
  userType          UserType
  email             String           @unique
  firstName         String
  lastName          String
  nationalId        String?          @unique
  gender            Gender?
  birthDate         DateTime?
  preferredLanguage String           @default("fr")
  phone             String?
  avatarUrl         String?
  address           String?
  city              String?
  wilaya            String?
  postalCode        String?
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  isVerified        Boolean          @default(false)
  accountStatus     AccountStatus    @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  admin             Admin?
  doctor            Doctor?
  laboratoryStaff   LaboratoryStaff?
  patient           Patient?
  pharmacist        Pharmacist?

  @@index([userType])
  @@index([city])
  @@index([wilaya])
}

model HealthcareFacility {
  id                 String               @id @default(uuid())
  name               String
  type               FacilityType
  registrationNumber String?              @unique
  description        String?
  phone              String?
  email              String?
  website            String?
  address            String?
  city               String?
  wilaya             String?
  postalCode         String?
  latitude           Decimal?             @db.Decimal(10, 7)
  longitude          Decimal?             @db.Decimal(10, 7)
  openingHours       Json?
  emergencyService   Boolean              @default(false)
  isVerified         Boolean              @default(false)
  logoUrl            String?
  coverImageUrl      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  doctors            DoctorFacility[]
  laboratoryStaff    LaboratoryFacility[]
  pharmacists        PharmacistFacility[]

  @@index([type])
  @@index([city])
  @@index([wilaya])
}

model Specialty {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  doctors     DoctorSpecialty[]
}

model Doctor {
  id        String @id @default(uuid())
  profileId String @unique

  // Professional identification
  licenseNumber        String  @unique
  nationalRegistration String? @unique

  // Education
  diploma        String?
  diplomaNumber  String?
  graduationYear Int?

  // Experience
  startPracticeYear Int?
  yearsExperience   Int?

  // Professional information
  biography             String?
  consultationLanguages String?
  education             String?
  certifications        String?

  // Consultation
  consultationFee        Decimal? @db.Decimal(10, 2)
  consultationDuration   Int?
  acceptsOnline          Boolean  @default(false)
  acceptsHomeVisit       Boolean  @default(false)
  isAcceptingNewPatients Boolean  @default(true)

  // Rating
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalReviews  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  facilities     DoctorFacility[]
  specialties    DoctorSpecialty[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
}

model DoctorSpecialty {
  doctorId    String
  specialtyId String
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
}

model DoctorFacility {
  doctorId   String
  facilityId String
  doctor     Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility   HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([doctorId, facilityId])
}

model Patient {
  id        String @id @default(uuid())
  profileId String @unique

  // ============================================================
  // MEDICAL INFORMATION PROVIDED BY THE PATIENT
  // ============================================================

  bloodType            String?
  allergies            String?
  chronicConditions    String?
  currentMedications   String?
  medicalHistory       String?
  surgicalHistory      String?
  familyMedicalHistory String?
  vaccinationHistory   String?

  // ============================================================
  // LIFESTYLE
  // ============================================================

  smokingStatus      String?
  alcoholConsumption String?
  physicalActivity   String?
  diet               String?

  // ============================================================
  // ADDITIONAL MEDICAL INFORMATION
  // ============================================================

  additionalMedicalInfo String?

  // ============================================================
  // EMERGENCY CONTACT
  // ============================================================

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // ============================================================
  // GUARDIAN - MAINLY FOR MINORS
  // ============================================================

  guardianFirstName String?
  guardianLastName  String?
  guardianEmail     String?
  guardianPhone     String?
  guardianRelation  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations     AIConversation[]
  appointments      Appointment[]
  laboratoryResults LaboratoryResult[]
  medicalRecords    MedicalRecord[]
  profile           Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  prescriptions     Prescription[]
  refillRequests    RefillRequest[]
  vaccinations      Vaccination[]
}

model Pharmacist {
  id            String               @id @default(uuid())
  profileId     String               @unique
  licenseNumber String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  profile       Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  facilities    PharmacistFacility[]
}

model PharmacistFacility {
  pharmacistId String
  facilityId   String
  facility     HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  pharmacist   Pharmacist         @relation(fields: [pharmacistId], references: [id], onDelete: Cascade)

  @@id([pharmacistId, facilityId])
}

model LaboratoryStaff {
  id            String               @id @default(uuid())
  profileId     String               @unique
  licenseNumber String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  facilities    LaboratoryFacility[]
  profile       Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LaboratoryFacility {
  laboratoryStaffId String
  facilityId        String
  facility          HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  laboratoryStaff   LaboratoryStaff    @relation(fields: [laboratoryStaffId], references: [id], onDelete: Cascade)

  @@id([laboratoryStaffId, facilityId])
}

model Admin {
  id        String   @id @default(uuid())
  profileId String   @unique
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  type            AppointmentType   @default(IN_PERSON)
  status          AppointmentStatus @default(PENDING)
  reason          String?
  notes           String?
  location        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
}

model MedicalRecord {
  id         String   @id @default(uuid())
  patientId  String
  doctorId   String?
  title      String
  diagnosis  String?
  symptoms   String?
  notes      String?
  recordDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  doctor     Doctor?  @relation(fields: [doctorId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id                 String             @id @default(uuid())
  patientId          String
  doctorId           String
  prescriptionNumber String             @unique
  prescribedDate     DateTime           @default(now())
  startDate          DateTime?
  endDate            DateTime?
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items              PrescriptionItem[]
  refillRequests     RefillRequest[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicationName String
  dosage         String
  frequency      String?
  route          String?
  durationDays   Int?
  quantity       Int?
  instructions   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model RefillRequest {
  id             String       @id @default(uuid())
  patientId      String
  prescriptionId String
  requestedDate  DateTime     @default(now())
  status         RefillStatus @default(REQUESTED)
  notes          String?
  response       String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([prescriptionId])
  @@index([status])
}

model LaboratoryResult {
  id             String                @id @default(uuid())
  patientId      String
  testName       String
  laboratoryName String?
  testDate       DateTime
  status         LaboratoryStatus      @default(PENDING)
  reportUrl      String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  parameters     LaboratoryParameter[]
  patient        Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([testDate])
  @@index([status])
}

model LaboratoryParameter {
  id                 String           @id @default(uuid())
  laboratoryResultId String
  name               String
  value              String
  unit               String?
  referenceMin       Decimal?         @db.Decimal(10, 3)
  referenceMax       Decimal?         @db.Decimal(10, 3)
  flag               ResultFlag       @default(NORMAL)
  createdAt          DateTime         @default(now())
  laboratoryResult   LaboratoryResult @relation(fields: [laboratoryResultId], references: [id], onDelete: Cascade)

  @@index([laboratoryResultId])
}

model Vaccination {
  id              String    @id @default(uuid())
  patientId       String
  vaccineName     String
  dose            String?
  vaccinationDate DateTime
  nextDueDate     DateTime?
  provider        String?
  batchNumber     String?
  notes           String?
  createdAt       DateTime  @default(now())
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([vaccinationDate])
}

model AIConversation {
  id        String             @id @default(uuid())
  patientId String
  title     String?
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([patientId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum UserType {
  PATIENT
  DOCTOR
  PHARMACIST
  LABORATORY_STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  ONLINE
  HOME_VISIT
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RefillStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum LaboratoryStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

enum FacilityType {
  HOSPITAL
  CLINIC
  PRIVATE_OFFICE
  PHARMACY
  LABORATORY
  HEALTH_CENTER
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}
